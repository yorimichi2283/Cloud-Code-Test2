{
  "id": "jp.yorimichi.ppro.telop-shifter",
  "name": "Telop Shifter",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.2.0"
    }
  ],
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "telopShifterPanel",
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "maximumSize": {
        "width": 900,
        "height": 1400
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 520
      },
      "label": {
        "default": "Telop Shifter"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
